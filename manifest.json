{
  "$schema": "https://raw.githubusercontent.com/Passimoritz/hostwerk-public/main/sdk/manifest.schema.json",
  "id": "discord-status",
  "name": {
    "de": "Discord-Status",
    "en": "Discord status"
  },
  "description": {
    "de": "Zeigt in deinem Discord-Profil „Spielt Hostwerk“ – mit den laufenden Dienstarten, nie mit Projekt- oder Servernamen. Verbindet sich direkt mit dem Discord auf diesem PC, ohne Internet.",
    "en": "Shows “Playing Hostwerk” in your Discord profile – with the kinds of services running, never project or server names. Talks directly to Discord on this PC, no internet needed."
  },
  "version": "1.0.0",
  "author": "Hostwerk",
  "homepage": "https://github.com/Passimoritz/hostwerk-ext-discord-status",
  "license": "MIT",
  "icon": "icon.svg",
  "banner": "banner.svg",
  "color": "#5865f2",
  "category": "communication",
  "hostwerk": ">=2.9.0",
  "permissions": [
    "native"
  ],
  "page": {
    "title": {
      "de": "Discord-Status",
      "en": "Discord status"
    },
    "description": {
      "de": "„Spielt Hostwerk“ im Discord-Profil.",
      "en": "“Playing Hostwerk” in your Discord profile."
    },
    "icon": "message"
  },
  "backend": "server/index.js",
  "ui": "ui/index.js",
  "screenshots": [
    "docs/screenshot.png",
    "docs/screenshot.de.png"
  ]
}
